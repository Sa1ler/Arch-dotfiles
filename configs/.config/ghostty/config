# ===== Тема / фон / стекло =====
theme = Ayu Mirage
window-theme = dark

# Более тёмный фон, чем стандартный Ayu Mirage
background = #0b1118
foreground = #d9e4f2
cursor-color = #8fd3ff
cursor-text = #0b1118
selection-background = #24405c
selection-foreground = #ecf4ff

# Чуть прозрачно: 0.84 = 84% непрозрачности
background-opacity = 0.84

# Немного повышает читаемость на полупрозрачном фоне
minimum-contrast = 1.08


# ===== Шрифт =====
# Если установлен Nerd Font вариант:
font-family = CaskaydiaCove Nerd Font

# Если Nerd Font не ставишь, закомментируй строку выше и раскомментируй:
# font-family = Cascadia Code

font-size = 12
font-feature = +liga
font-feature = +calt

# Чуть больше воздуха между строками
adjust-cell-height = 1


# ===== Окно и поведение =====
window-vsync = true
window-padding-x = 12
window-padding-y = 10
window-padding-balance = true
window-padding-color = background

window-save-state = always
window-inherit-font-size = true
window-inherit-working-directory = true

confirm-close-surface = false
mouse-hide-while-typing = true
unfocused-split-opacity = 0.94
scrollback-limit = 200000


# ===== Курсор и буфер обмена =====
cursor-style = bar
cursor-style-blink = false

copy-on-select = true
clipboard-read = allow
clipboard-write = allow
clipboard-paste-protection = true
clipboard-paste-bracketed-safe = true


# ===== Shell integration =====
shell-integration = detect
shell-integration-features = cursor,sudo,title


# ===== Шорткаты: базовые =====
keybind = ctrl+shift+n=new_window
keybind = ctrl+shift+t=new_tab
keybind = ctrl+shift+w=close_surface
keybind = ctrl+alt+q=close_window

keybind = ctrl+shift+f=toggle_fullscreen
keybind = ctrl+shift+r=reload_config

keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard


# ===== Шорткаты: шрифт =====
keybind = ctrl+equal=increase_font_size:1
keybind = ctrl+shift+equal=increase_font_size:1
keybind = ctrl+minus=decrease_font_size:1
keybind = ctrl+0=reset_font_size


# ===== Шорткаты: вкладки =====
keybind = ctrl+page_up=previous_tab
keybind = ctrl+page_down=next_tab


# ===== Шорткаты: сплиты =====
keybind = ctrl+shift+d=new_split:right
keybind = ctrl+shift+e=new_split:down

keybind = ctrl+shift+h=goto_split:left
keybind = ctrl+shift+j=goto_split:down
keybind = ctrl+shift+k=goto_split:up
keybind = ctrl+shift+l=goto_split:right